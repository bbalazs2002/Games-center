{
  "name": "games-center",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:dama": "vitest run src/shared/games/dama src/server/games/dama",
    "test:hotel": "vitest run src/shared/games/hotel src/server/games/hotel",
    "test:ramses": "vitest run src/shared/games/ramses",
    "lint": "eslint .",
    "format": "prettier --write .",
    "server:dev": "tsx watch src/server/index.ts",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "assets:convert-heic": "node scripts/convert-hotel-heic.mjs",
    "assets:resize-images": "node scripts/resize-hotel-images.mjs",
    "assets:compress-hotel-glb": "node scripts/compress-hotel-glb.mjs",
    "ai:simulate-hotel": "tsx scripts/simulate-hotel-ai-games.ts",
    "ai:simulate-ramses": "tsx scripts/simulate-ramses-ai-games.ts",
    "ai:simulate-dama": "tsx scripts/simulate-dama-ai-games.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@colyseus/schema": "^3.0.0",
    "@colyseus/ws-transport": "^0.16.0",
    "@prisma/client": "^6.2.1",
    "@react-spring/three": "^10.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "colyseus": "^0.16.0",
    "colyseus.js": "^0.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.26.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@gltf-transform/cli": "^4.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "heic-convert": "^2.1.0",
    "prettier": "^3.4.2",
    "prisma": "^6.2.1",
    "sharp": "^0.35.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.11",
    "vitest": "^3.0.4"
  }
}
