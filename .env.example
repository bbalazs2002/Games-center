# Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://games_center:games_center_dev@localhost:5432/games_center"

# Signing key for client/server auth — must be changed in production
JWT_SECRET="dev-only-change-me"

# Express + Colyseus HTTP server port
PORT=2567

# Client (Vite) — only VITE_-prefixed variables reach the browser
VITE_SERVER_URL="http://localhost:2567"
